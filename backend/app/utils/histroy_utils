from typing import Dict, List, Optional
import logging
from app.database.session import get_db  # Assuming you have a database session utility
from sqlalchemy import text

# Set up logging
logger = logging.getLogger(__name__)

async def get_user_history(user_id: str, action: Optional[str] = None) -> Dict[str, Any]:
    """
    Retrieve user history based on the action type.

    Args:
        user_id (str): Unique identifier for the user.
        action (Optional[str]): Type of action to filter history (e.g., "search", "view"). Defaults to None.

    Returns:
        Dict[str, Any]: User history and insights.
    """
    try:
        # Fetch history from the database
        db = await get_db()
        query = text("""
            SELECT id, action, data, timestamp
            FROM history
            WHERE user_id = :user_id
            ORDER BY timestamp DESC
        """)
        params = {"user_id": user_id}

        if action:
            query = text("""
                SELECT id, action, data, timestamp
                FROM history
                WHERE user_id = :user_id
                  AND action = :action
                ORDER BY timestamp DESC
            """)
            params["action"] = action

        result = await db.execute(query, params)
        history = [dict(row) for row in result]

        # Call Gemini API to get insights based on the history
        payload = {
            "query": f"Provide insights for a user with the following history: {history}"
        }
        response = await call_gemini_api("/query", payload)
        if response and "response" in response:
            insights = response["response"]
        else:
            insights = "No insights available."

        return {
            "status": "success",
            "history": history,
            "insights": insights,
        }

    except Exception as e:
        logger.error(f"Error fetching user history: {e}")
        return {"status": "error", "message": "Failed to fetch history"}