# NutriKnow API Configuration
PROJECT_NAME="NutriKnow API"
VERSION="1.0.0"

# Database configuration
DATABASE_URL="sqlite:///./nutriknow.db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# API Keys
# You need to provide a valid Gemini API key from https://makersuite.google.com/app/apikey
# Set either GEMINI_API_KEY or GOOGLE_API_KEY, the application will use GEMINI_API_KEY if both are set
GEMINI_API_KEY=AIzaSyAB5jKOflFnIQ5-4bPoYKbeDIr9DZ-f3Lc
GOOGLE_API_KEY=AIzaSyAB5jKOflFnIQ5-4bPoYKbeDIr9DZ-f3Lc

# API configuration
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://localhost:8080"]

# Security settings
SECRET_KEY="a_very_secret_key_for_nutriknow_api_please_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Redis settings (if used)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_TIMEOUT=5
CACHE_TTL=3600

# Logging
LOG_LEVEL="INFO"

# Rate limiting
RATE_LIMIT_PER_MINUTE=60